<Project>
  <!-- Applies to every project in the repository, so .csproj files stay short. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- AutoMapper <= 14 (MIT): stack overflow when mapping deeply nested self-referencing objects.
         Shifa maps flat models/DTOs only (no self-referencing graphs), so the risk doesn't apply.
         Review again before mapping any recursive type, or move to a patched version. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x" />
  </ItemGroup>
</Project>

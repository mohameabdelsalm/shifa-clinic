<Project>
  <!-- Applies to every project in the repository, so .csproj files stay short. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- AutoMapper <= 14 (MIT): stack overflow when mapping deeply nested self-referencing objects.
         Shifa maps flat models/DTOs only (no self-referencing graphs), so the risk doesn't apply.
         Review again before mapping any recursive type, or move to a patched version. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x" />
    <!-- 2026-11-13, same class (MaxDepth bypass): recursion through constructor parameters, polymorphic maps
         (Include/IncludeBase), object/interface-typed members. Shifa has none of these: destinations are classes built by
         property setters, no Include, no object/interface members, no self-referencing types. Product owner chose to
         suppress (2026-11-16); revisit if any map starts using those features. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-6vhm-j9h7-f9gh" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gpwp-5797-mjff" />
  </ItemGroup>
</Project>

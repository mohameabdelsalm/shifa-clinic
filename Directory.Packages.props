<Project>
  <!-- Central Package Management: every package version lives here, once.
       .csproj files list <PackageReference Include="..." /> without a Version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Versions below also apply to transitive dependencies, so a vulnerable
         package pulled in indirectly can be pinned to a patched version. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!-- Data -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.14" />
  </ItemGroup>
  <!-- API -->
  <ItemGroup>
    <!-- Last MIT version (15+ is commercial). GHSA-rvv3-g6hj-g44x is suppressed in Directory.Build.props. -->
    <PackageVersion Include="AutoMapper" Version="14.0.0" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.1.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>
  <!-- Jobs and e-mail (ADR-015). Hangfire is LGPL-3.0 (used unmodified as a library); MailKit is MIT. -->
  <ItemGroup>
    <PackageVersion Include="Hangfire.Core" Version="1.8.25" />
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageVersion Include="Hangfire.SqlServer" Version="1.8.25" />
    <PackageVersion Include="MailKit" Version="4.18.2" />
  </ItemGroup>
  <!-- Report exports (ADR-016). ClosedXML is MIT (same as Trio HRM). QuestPDF needs a license type: Community only for
       organizations under USD 1M annual revenue, otherwise Professional/Enterprise (Reports:QuestPdfLicense). -->
  <ItemGroup>
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <PackageVersion Include="QuestPDF" Version="2026.9.2" />
  </ItemGroup>
  <!-- Testing (Shifa.Tests) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
  <!-- Security pins for transitive dependencies -->
  <ItemGroup>
    <!-- Microsoft.Data.SqlClient 6.1.7 pulls 9.0.11, which has known vulnerabilities
         (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <!-- Hangfire.Core asks for Newtonsoft.Json >= 11.0.1, which has GHSA-5crp-9r3c-p9vr; 13.x is patched. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
</Project>
<Project Sdk="Microsoft.NET.Sdk">

  <!-- Enforces the module boundary and data ownership rules (ADR-001, ADR-002).
       If a test here fails, fix the code; never weaken the test. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <!-- Every module implementation must be referenced here so its DbContext model is checked.
       ModuleAssemblies fails when a module is missing from this list. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Shifa.Infrastructure\Shifa.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Modules\Tenancy\Shifa.Tenancy\Shifa.Tenancy.csproj" />
    <ProjectReference Include="..\..\src\Modules\Clinic\Shifa.Clinic\Shifa.Clinic.csproj" />
  </ItemGroup>

</Project>

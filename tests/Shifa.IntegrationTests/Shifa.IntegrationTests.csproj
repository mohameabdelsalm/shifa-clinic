<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs against a real SQL Server (local instance, database Shifa_Tests by default;
       override with the SHIFA_TEST_CONNECTION environment variable). Never use EF InMemory here:
       these tests prove SQL Server behavior (filters, keys, constraints, HiLo). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Respawn" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shifa.API\Shifa.API.csproj" />
  </ItemGroup>

</Project>

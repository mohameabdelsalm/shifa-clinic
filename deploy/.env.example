# Shifa production settings (ADR-017). Copy to .env and fill in. NEVER commit .env (it holds secrets).
# Names use "__" for nested settings (Jwt__SigningKey = Jwt:SigningKey).

# --- Domain (Caddy gets the HTTPS certificate for it) ---
SHIFA_DOMAIN=api.example.com

# --- Database: licensed SQL Server or Azure SQL (never Developer Edition). Use a dedicated login with least privilege. ---
ConnectionStrings__Shifa=Server=sql.example.internal;Database=Shifa;User Id=shifa_app;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=False

# --- Tokens: a random secret of 64+ characters (e.g. openssl rand -base64 64). Rotation: move the old one to PreviousSigningKeys__0. ---
Jwt__SigningKey=CHANGE_ME_64_RANDOM_CHARACTERS
# Jwt__PreviousSigningKeys__0=

# --- Reverse proxy: the docker network subnet from docker-compose.yml (forwarded client IPs are trusted only from it) ---
ReverseProxy__KnownNetworks__0=172.30.0.0/24

# --- Browser apps allowed to call the API (staff app, patient portal) ---
Cors__AllowedOrigins__0=https://app.example.com
# Cors__AllowedOrigins__1=https://portal.example.com

# --- Links in e-mails (set-password / reset) point to the staff app ---
App__StaffAppUrl=https://app.example.com

# --- E-mail (SMTP). SmtpSecurity: StartTls (587) | SslOnConnect (465) | None (local test only) ---
Email__From=no-reply@example.com
Email__FromName=Shifa
Email__SmtpHost=smtp.example.com
Email__SmtpPort=587
Email__SmtpSecurity=StartTls
Email__SmtpUserName=CHANGE_ME
Email__SmtpPassword=CHANGE_ME

# --- SMS: no provider chosen yet. Disabled = portal sign-in codes and SMS reminders are skipped (e-mail still works). ---
Sms__Provider=Disabled

# --- Online payments (Paymob, per clinic keys are stored encrypted in the database) ---
Paymob__NotificationBaseUrl=https://api.example.com
Paymob__RedirectionUrl=https://portal.example.com/payment-result

# --- PDF reports: Community only for organizations under USD 1M annual gross revenue; else Professional or Enterprise ---
Reports__QuestPdfLicense=CHANGE_ME

# --- Background jobs (Hangfire). Set false on extra instances if you want jobs on one instance only. ---
Jobs__Enabled=true

# Already set in the image (change only if you know why):
# DataProtection__KeysPath=/data/keys
# FileStorage__RootPath=/data/files
# Reports__PdfFontFamilies=Noto Naskh Arabic
